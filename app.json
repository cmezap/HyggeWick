{
  "expo": {
    "name": "HyggeWick",
    "slug": "HyggeWick",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/Hyggewick_icon.png",
    "scheme": "hyggewick",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.hyggewick.app",
      "adaptiveIcon": {
        "backgroundColor": "#01010B",
        "foregroundImage": "./assets/images/Hyggewick_icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "70023f5e-a806-49c9-9522-a15b44d2c352"
      }
    },
    "owner": "erickbaladi"
  }
}
